# Front-end build-time variables: Vite inlines them, so a change needs a rebuild.

# Backend origin, scheme included, no trailing slash. Empty = same origin.
VITE_API_BASE=https://api-indicios-desinformacao.contardi.com.br

# 1 hides the score and every percentage (public deployment); 0 shows them (demonstration).
VITE_PUBLIC_BUILD=1
