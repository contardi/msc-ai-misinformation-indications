FROM python:3.13-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

COPY backend/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

ARG INSTALL_TRANSFORMER=0
COPY backend/requirements-transformer.txt ./
RUN if [ "$INSTALL_TRANSFORMER" = "1" ]; then \
        pip install --no-cache-dir -r requirements-transformer.txt; \
    fi

ARG INSTALL_MEDIA=0
COPY backend/requirements-media.txt ./
RUN if [ "$INSTALL_MEDIA" = "1" ]; then \
        apt-get update && apt-get install -y --no-install-recommends ffmpeg \
        && rm -rf /var/lib/apt/lists/* \
        && pip install --no-cache-dir -r requirements-media.txt; \
    fi

ENV HF_HOME=/opt/hf
ARG WHISPER_MODEL=small
ENV WHISPER_MODEL=${WHISPER_MODEL}
RUN if [ "$INSTALL_MEDIA" = "1" ]; then \
        python -c "from faster_whisper import WhisperModel; \
                   WhisperModel('${WHISPER_MODEL}', device='cpu', compute_type='int8')"; \
    fi

COPY ml/artifacts/baseline_tfidf_logreg.joblib ml/artifacts/baseline_tfidf_logreg.meta.json /app/artifacts/
COPY data/processed/claimreview_br.csv /app/data/processed/

ENV MODEL_PATH=/app/artifacts/baseline_tfidf_logreg.joblib \
    CLAIMREVIEW_INDEX=/app/data/processed/claimreview_br.csv

COPY infra/postgres/schema.sql ./infra/postgres/schema.sql

COPY backend/app ./app

EXPOSE 8000

CMD python -m app.migrate && uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}
