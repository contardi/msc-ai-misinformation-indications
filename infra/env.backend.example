# Backend service variables (runtime unless noted). Do not commit real secrets.

# Front-end origin(s), comma-separated, scheme included, no trailing slash.
ALLOWED_ORIGINS=https://indicios-desinformacao.contardi.com.br
PORT=8000

MODEL_PATH=/app/artifacts/baseline_tfidf_logreg.joblib
CLAIMREVIEW_INDEX=/app/data/processed/claimreview_br.csv

# Harvested fact-check cache. Empty = that source disables itself.
DATABASE_URL=

# Live evidence (Google Fact Check Tools). Empty = no external call.
GOOGLE_FACTCHECK_API_KEY=

# "baseline" (TF-IDF + logistic regression) or "transformer".
MODEL_KIND=baseline

# Keep 0 unless the origin only accepts traffic from Cloudflare.
TRUST_PROXY_HEADERS=0
RATE_LIMIT=120/minute
MEDIA_RATE_LIMIT=5/minute
BLOCKED_IPS=

# Read once at start-up.
MAX_TEXT_CHARS=20000

# Build-time switches.
INSTALL_MEDIA=1
INSTALL_TRANSFORMER=0
