# Copy to .env (gitignored). Every key is optional; empty keys disable the feature they serve.

# Google Fact Check Tools API key: live evidence layer. Empty = fully offline.
GOOGLE_FACTCHECK_API_KEY=

# Optional fact-check tuning.
# FACTCHECK_TIMEOUT=
# FACTCHECK_MAX_RESULTS=
# FACTCHECK_LANGUAGE=

# HuggingFace token, only for ml/src/push_to_hub.py.
HUGGINGFACE_API_KEY=

# Maritaca key, only for the offline LLM comparison in ml/src/evaluation (spends credit).
MARITACA_API_KEY=
